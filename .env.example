# Use URL-safe values for the database password because it is embedded in a URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Host clients and the Web Console use the host token. Nodes use the node token.
RELAY_HOST_TOKEN=replace-with-a-long-random-host-token
RELAY_NODE_TOKEN=replace-with-a-long-random-node-token

# Public listening port and the access scope assigned to the host token.
RELAY_SERVER_PORT=8787
RELAY_TENANT_ID=default
RELAY_PROJECT_ID=default

# Optional: expose PostgreSQL only on localhost for diagnostics and integration tests.
RELAY_POSTGRES_PORT=55432
